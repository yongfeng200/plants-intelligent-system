# ============================================================
# 数据集：体积过大（合计约 5.5 GB），不入库
# ============================================================
/Grape Detection Segment/
/Grape Disease Dataset/
/Leaf Disease Segment/
/Mango Dataset/
/Mango Leaf Dataset/
/Niphad Grape Leaf Disease Dataset (NGLD)/

# ============================================================
# 模型权重：单个最大 275 MB，超过 GitHub 100 MB 限制
# ============================================================
/models/*.pth
/models/*.pt
/models/*.pkl
/models/*.ckpt
# 两个 class_to_idx 映射表只有几 KB，保留
!/models/mango_variety_class_to_idx.pth
!/models/mango_disease_to_idx.pth

# 预训练主干（ultralytics / SAM 会自动下载）
/train/**/*.pt
/train/**/*.pth
/train/**/weights/

# ============================================================
# 训练过程产物：只保留 csv / json / yaml 指标
# ============================================================
/train/runs/**/*.png
/train/runs/**/*.jpg
/train/runs/**/*.jpeg
/train/runs/**/*.svg

# ============================================================
# 运行时生成
# ============================================================
/uploads/
/database/*.db
/database/*.db-journal
/database/*.db-wal
/database/*.db-shm
__pycache__/
*.py[cod]
*.tmpc

# ============================================================
# 编辑器 / 系统
# ============================================================
.idea/
.vscode/
*.swp
Thumbs.db
desktop.ini

# ============================================================
# 本地私有文件
# ============================================================
*.pem
.env
