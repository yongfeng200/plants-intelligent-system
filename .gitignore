# ============================================================
# 数据集：只上传 5 个测试集（1686 个文件 / 约 360 MB）
# 训练集与验证集体积过大，继续排除
# ============================================================
/Grape Detection Segment/*
!/Grape Detection Segment/yolo_seg_dataset/
/Grape Detection Segment/yolo_seg_dataset/*
!/Grape Detection Segment/yolo_seg_dataset/test/

/Grape Disease Dataset/*
!/Grape Disease Dataset/test/

/Leaf Disease Segment/*
!/Leaf Disease Segment/classification/
/Leaf Disease Segment/classification/*
!/Leaf Disease Segment/classification/test/

/Mango Dataset/*
!/Mango Dataset/test/

/Mango Leaf Dataset/*
!/Mango Leaf Dataset/test/

/Niphad Grape Leaf Disease Dataset (NGLD)/

# ============================================================
# 模型权重：默认忽略，只放推理必需的权重（约 349 MB）
# 含优化器状态的训练检查点单文件超 100 MiB，无法入库
# ============================================================
/models/*.pth
/models/*.pt
/models/*.pkl
/models/*.ckpt
# 推理权重：5 个页面实际加载的文件
!/models/mango_mdcn_best_checkpoint.pth
!/models/mango_variety_model.pth
!/models/grape_disease_model.pth
!/models/grape_segment_model.pt
!/models/leaf_disease_segment_model.pth
!/models/leaf_disease_classify_model.pth
# 两个 class_to_idx 映射表只有几 KB
!/models/mango_variety_class_to_idx.pth
!/models/mango_disease_to_idx.pth
# OOD 校准统计量（models/ood_stats/*.npz，约 1.9 MB）随仓库提供

# 预训练主干（ultralytics / SAM 会自动下载）
/train/**/*.pt
/train/**/*.pth
/train/**/weights/

# ============================================================
# 训练过程产物：只保留 csv / json / yaml 指标
# ============================================================
/train/runs/**/*.png
/train/runs/**/*.jpg
/train/runs/**/*.jpeg
/train/runs/**/*.svg

# ============================================================
# 运行时生成
# ============================================================
/uploads/
/database/*.db
/database/*.db-journal
/database/*.db-wal
/database/*.db-shm
__pycache__/
*.py[cod]
*.tmpc
.pytest_cache/

# ============================================================
# 本地临时脚本（以 _ 开头的根目录探针）
# ============================================================
/_*_probe.py
/_tmp_*.py

# ============================================================
# 编辑器 / 系统
# ============================================================
.idea/
.vscode/
*.swp
Thumbs.db
desktop.ini

# ============================================================
# 本地私有文件
# ============================================================
*.pem
.env
